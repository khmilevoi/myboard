# dependencies
node_modules/
.pnp/
.pnp.js
.pnpm-store

# build output
dist/
build/
.vite/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# env / local
.env
.env.local
.env.*.local
# secrets bundle of the `dev` rpi environment (see .env.dev.example)
.env.dev
# secrets bundle of the `branch` rpi environment (see .env.branch.example)
.env.branch

# editor / os
.DS_Store
.idea/
.vscode/
*.swp

# brainstorming visual companion
.superpowers/

# Playwright
playwright-report/
test-results/

# git worktrees (local development branches)
.worktrees/

# generated widget registries
packages/client/src/widget-registry/model/*.generated.ts
packages/server/src/widgets/widget-server-list.generated.ts
packages/browser-automation/src/tasks/widget-browser-list.generated.ts

# browser-automation local (non-Docker) dev
packages/browser-automation/.dev-profile/
packages/browser-automation/.dev-secrets/

# passport-checker widget secrets: real values are local-only and delivered to
# the Pi via `rpi secrets push` and `rpi secrets push --group dev`
# ([secrets].files in rpi.toml is the push source for both); only the .example
# placeholder templates are tracked.
packages/widgets/passport-checker/secrets/*
!packages/widgets/passport-checker/secrets/*.example

# Looper loop scratch/observability (local only, not part of the deliverable)
looper-output/
