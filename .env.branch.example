# Template for .env.branch — the contents of the `branch` secret group, which
# configures the `branch` rpi environment (see rpi.branch.toml). Copy it and
# push it into the group:
#
#   cp .env.branch.example .env.branch
#   rpi secrets push --group branch --env branch
#
# Nothing in here changes when you switch branches — only `source.branch` does,
# and rpi resolves that from the checkout itself through `${git.branch}`, so no
# `--vars` are involved any more. This file is written once and left alone: the
# group belongs to the base project, so neither `rpi env destroy branch` nor the
# 72h TTL reaper takes it down with the stand, and the environment's own secrets
# bundle stays empty.
#
# .env.branch itself is untracked; rpi encrypts it and the agent writes the
# merged result into the project workdir next to docker-compose.yml, where
# Compose reads it for ${VAR} interpolation.
#
# The passport-checker widget's series/number are NOT set here: rpi.branch.toml
# clears [secrets].files and attaches the `dev` group underneath this one, which
# carries the two plain-value files (see
# packages/browser-automation/README.md#provisioning-secrets) and is pushed once
# from the repository root with `rpi secrets push --group dev`. `dev` is applied
# first and `branch` on top, so every key below overrides it.
# `rpi secrets ls --env branch` shows which layer each entry comes from.

# --- WebAuthn gate: must match ingress.hostname in rpi.branch.toml ---
# Credentials are scoped to RP_ID and assertions are verified against
# EXPECTED_ORIGIN, so production's board.iiskelo.com defaults would reject every
# ceremony on this host. The stand keeps its Valkey volume across branches, so
# the device stays invited once it is — a fresh invite is only needed the first
# time, and after `rpi env reset-data branch` or a TTL teardown:
#   rpi command create-invite --env branch
RP_ID=board-branch.iiskelo.com
RP_NAME=MyBoard-branch
PUBLIC_APP_URL=https://board-branch.iiskelo.com
EXPECTED_ORIGIN=https://board-branch.iiskelo.com

# --- Host ports: keep this stack off production's and dev's binds ---
# rpi allocates the ingress host port itself out of 8000-8999, so these fixed
# extras must stay outside that range to avoid colliding with a future project.
# dev uses 9080/6380/6180 (see .env.dev.example); these are the next slots up.
CLIENT_HOST_PORT=9081
VALKEY_HOST_PORT=6381
NOVNC_HOST_PORT=6181

# --- Browser automation SSH fallback ---
# Non-secret operational config (see packages/browser-automation/README.md).
# Without it, the noVNC recovery modal on this stack has no SSH-tunnel hint at
# all — same Pi as production, so the same SSH target reaches it.
AUTOMATION_SSH_TARGET=<ssh target for the Pi>
