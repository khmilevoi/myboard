# Template for .env.dev — the secrets bundle of the `dev` rpi environment
# (see rpi.dev.toml). Copy to .env.dev and fill in the values:
#
#   cp .env.dev.example .env.dev
#   rpi secrets push --env dev
#
# .env.dev itself is untracked; rpi encrypts it and the agent writes it into the
# project workdir next to docker-compose.yml, where Compose reads it for ${VAR}
# interpolation.
#
# The passport-checker widget's series/number are NOT set here and are no longer
# part of this bundle either: rpi.dev.toml clears [secrets].files and attaches
# the `dev` secret group instead, which carries the two plain-value files (see
# packages/browser-automation/README.md#provisioning-secrets). The group is
# pushed once from the repository root with `rpi secrets push --group dev`, not
# per environment. `rpi secrets ls --env dev` shows which layer each entry comes
# from.

# --- WebAuthn gate: must match ingress.hostname in rpi.dev.toml ---
# Credentials are scoped to RP_ID and assertions are verified against
# EXPECTED_ORIGIN, so production's board.iiskelo.com defaults would reject every
# ceremony on this host.
RP_ID=board-dev.iiskelo.com
RP_NAME=MyBoard-dev
PUBLIC_APP_URL=https://board-dev.iiskelo.com
EXPECTED_ORIGIN=https://board-dev.iiskelo.com

# --- Host ports: keep this stack off production's binds ---
# rpi allocates the ingress host port itself out of 8000-8999, so these fixed
# extras must stay outside that range to avoid colliding with a future project.
CLIENT_HOST_PORT=9080
VALKEY_HOST_PORT=6380
NOVNC_HOST_PORT=6180

# --- Browser automation SSH fallback ---
# Non-secret operational config (see packages/browser-automation/README.md).
# Without it, the noVNC recovery modal on this stack has no SSH-tunnel hint at
# all — same Pi as production, so the same SSH target reaches it.
AUTOMATION_SSH_TARGET=<ssh target for the Pi>
